DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yuzimi-online-bucket
R2_PUBLIC_URL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PUBLIC_STORE_URL=https://yuzimi.online
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: only needed if using Stripe.js elsewhere. Hosted Checkout works without it.
