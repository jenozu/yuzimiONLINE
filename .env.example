# Transactional email (Resend)
RESEND_API_KEY=re_...
RESEND_ORDER_FROM=yuzimiONLINE <orders@yuzimi.online>
# Keep set to your own inbox while validating email delivery; remove before public launch.
RESEND_TEST_RECIPIENT=
# Optional monitored inbox for customer replies.
RESEND_REPLY_TO=

# Support contact form
SUPPORT_INBOX=
RESEND_SUPPORT_FROM=yuzimiONLINE Support <support@yuzimi.online>
