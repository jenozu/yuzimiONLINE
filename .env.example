DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yuzimi-online-bucket
R2_PUBLIC_URL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: only needed if using Stripe.js elsewhere. Hosted Checkout works without it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Transactional email (Resend)
RESEND_API_KEY=re_...
# Temporary test sender until YUZIMI owns and verifies its own domain.
RESEND_ORDER_FROM=yuzimiONLINE <onboarding@resend.dev>
# While using the Resend test sender, route all confirmations to the store owner's test inbox.
# Remove this override after a YUZIMI domain is verified so confirmations go to the Stripe customer email.
RESEND_TEST_RECIPIENT=
# Optional address for customer replies after a monitored inbox is available.
RESEND_REPLY_TO=
